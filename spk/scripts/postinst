#!/bin/sh
set -eu
PY=/var/packages/python311/target/bin/python3.11
VAR=/var/packages/VeraMesh/var/vera
STATE=$VAR/scaffold-state.json
CONFIG=$VAR/edge-config.json
"$PY" "$SYNOPKG_PKGDEST/bin/veramesh_state.py" initialize "$STATE"
if [ ! -e "$CONFIG" ]; then
  umask 077
  printf '%s\n' '{"connect_timeout_s":5.0,"idle_timeout_s":300.0,"listen_host":"127.0.0.1","listen_port":17445,"max_connections":32,"schema":"VERA_MESH_EDGE_CONFIG_V1","target_host":"100.88.50.35","target_port":17444}' > "$CONFIG.new"
  chmod 600 "$CONFIG.new"
  mv "$CONFIG.new" "$CONFIG"
fi
"$PY" "$SYNOPKG_PKGDEST/bin/veramesh_lifecycle.py" postinstall "${SYNOPKG_PKG_STATUS:-}"

#!/bin/sh
set -eu
NODE_BIN="${VERAMESH_NODE_BIN:-/usr/local/bin/node}"
[ -x "$NODE_BIN" ] || { echo "Node.js v22 runtime not found at $NODE_BIN" >&2; exit 1; }
"$NODE_BIN" -e 'process.exit(Number(process.versions.node.split(".")[0]) === 22 ? 0 : 1)' >/dev/null 2>&1 || {
  echo "VeraMesh repair build requires Node.js major 22" >&2
  exit 1
}
exit 0
